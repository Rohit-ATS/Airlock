## TrueForge harness for AIRLOCK. Copy to .env — never commit the result.
##
## NOTE: no model key goes here. TrueForge takes provider credentials at
## RUNTIME through PUT /api/v1/settings/model-providers, not from the
## environment. Use `npm run harness:setup` from the repo root, which reads
## OPENAI_API_KEY from the root .env and registers it for you.

POSTGRES_USER=trueforge
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=trueforge

## Only read when STANDALONE=true, which this compose does not use.
# SQLITE_PATH=
