# AIRLOCK — everything here is optional. A fresh clone runs with none of it set.

# ---------------------------------------------------------------------------
# The harness
# ---------------------------------------------------------------------------
# Where the TrueForge server is. Local mode is 8790, hosted mode is 8791.
# On Windows, TrueForge 0.1.4 does not start natively — use Docker.
# NEXT_PUBLIC_TRUEFORGE_BASE_URL=http://localhost:8791

# Server-side copy, used by the console's own API routes to resolve who is
# asking. Falls back to the public value above.
# TRUEFORGE_BASE_URL=http://localhost:8790

# ---------------------------------------------------------------------------
# The sandbox
# ---------------------------------------------------------------------------
# Where the shadow branch runs and every checksum in this project is produced.
# No sandbox means the agent can plan a migration and can never prove one, so
# this is load-bearing rather than optional.
#
# TrueForge 0.1.4 accepts exactly one provider — the server validates the
# manifest type against the literal string "daytona" — so there is no local or
# Docker-backed fallback. A key is free at https://app.daytona.io (Keys ->
# Create Key). Add it here, then run: npm run harness:sandbox
# DAYTONA_API_KEY=dtn_...

# ---------------------------------------------------------------------------
# The ledger
# ---------------------------------------------------------------------------
# Where the change ledger is written. A judge can read it with `cat`.
# AIRLOCK_DATA_DIR=./.airlock

# Start with an empty queue instead of seeding the eighteen console fixtures.
# AIRLOCK_NO_SEED=1

# ---------------------------------------------------------------------------
# Local SQLite verifier
# ---------------------------------------------------------------------------
# First-pass verification target for Damir's workstream. The verifier copies
# this file to a shadow SQLite database, applies forward SQL, rolls it back,
# compares checksums, and posts the resulting dossier to the console.
# SQLITE_PATH=./data/airlock.sqlite
# AIRLOCK_SEED_ROWS=50000
# AIRLOCK_DOSSIER_ID=dos_sqlite_tier_demo
# AIRLOCK_REQUESTED_BY=damir@airlock.dev

# ---------------------------------------------------------------------------
# Break-glass
# ---------------------------------------------------------------------------
# Two switches are required, and this is the deployment one: the change class
# must also permit it in policy. Off by default, deliberately.
#
# Break-glass does not open the gate — it cannot mint an approval grant. It
# records that a named human went around a sealed door, with a written reason,
# permanently, in the same hash chain as everything else.
# AIRLOCK_BREAK_GLASS=1

# ---------------------------------------------------------------------------
# The GitHub webhook
# ---------------------------------------------------------------------------
# Without this the webhook route refuses every request with a 503 rather than
# accepting unsigned payloads. There is no development bypass.
# GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# The MCP server (packages/mcp)
# ---------------------------------------------------------------------------
# Where the AIRLOCK console is, from the agent's point of view.
# AIRLOCK_CONSOLE_URL=http://localhost:3000
